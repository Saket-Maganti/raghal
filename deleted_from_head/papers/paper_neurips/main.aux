\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Fixed-generation metric fragility. Raw values are baseline$-$HCPC-v$1$ score differences on each scorer's native scale and \emph  {are not directly comparable across scorers}. Mistral z/rank columns standardize each scorer over the same fixed rows before computing the paired contrast; bootstrap CIs are in the supplement. The first two rows are legacy zero-shot label proxies that do not consume the retrieved context (\S  \ref {sec:setup}); the third is a context-conditioned local judge.}}{5}{table.caption.17}\protected@file@percent }
\newlabel{tab:metric_fragility_main}{{3}{5}{Fixed-generation metric fragility. Raw values are baseline$-$HCPC-v$1$ score differences on each scorer's native scale and \emph {are not directly comparable across scorers}. Mistral z/rank columns standardize each scorer over the same fixed rows before computing the paired contrast; bootstrap CIs are in the supplement. The first two rows are legacy zero-shot label proxies that do not consume the retrieved context (\S \ref {sec:setup}); the third is a context-conditioned local judge}{table.caption.17}{}}
