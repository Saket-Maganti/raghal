\citation{yan2024crag}
\citation{raptor2024}
\citation{asai2024selfrag}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Threshold transfer summary. For each tune dataset, $\tau ^\ast $ is the value of $\tau $ that maximises recovery on that dataset alone; ``diagonal recovery'' is recovery at $\tau ^\ast $ on the same dataset; ``off-diagonal mean'' is the mean recovery at $\tau ^\ast $ over the four \emph  {other} eval datasets. A large positive gap means the tuned $\tau ^\ast $ does not transport. The full per-cell transfer matrix is in supplement \S  9.}}{8}{table.caption.24}\protected@file@percent }
\newlabel{tab:threshold_transfer_main}{{5}{8}{Threshold transfer summary. For each tune dataset, $\tau ^\ast $ is the value of $\tau $ that maximises recovery on that dataset alone; ``diagonal recovery'' is recovery at $\tau ^\ast $ on the same dataset; ``off-diagonal mean'' is the mean recovery at $\tau ^\ast $ over the four \emph {other} eval datasets. A large positive gap means the tuned $\tau ^\ast $ does not transport. The full per-cell transfer matrix is in supplement \S 9}{table.caption.24}{}}
